<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9E9C5"
    tools:context=".login.PetStatusActivity">

    <ImageView
        android:layout_width="450dp"
        android:layout_height="450dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.10"
        android:scaleType="centerInside"
        android:src="@drawable/bg_cat_watermark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="寵物狀態登錄"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvPetPhoto"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="70dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <ImageView
            android:id="@+id/ivPetPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" /> </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvPetNameBadge"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_input"
        android:elevation="6dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="小花"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/cvPetPhoto"
        app:layout_constraintEnd_toEndOf="@id/cvPetPhoto"
        app:layout_constraintStart_toStartOf="@id/cvPetPhoto"
        app:layout_constraintTop_toBottomOf="@id/cvPetPhoto" />

    <LinearLayout
        android:id="@+id/llFormContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvPetNameBadge">

        <TextView
            android:id="@+id/tvActivityHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="center"
            android:padding="15dp"
            android:text="請選擇寵物活動量"
            android:textColor="#666666"
            android:textSize="18sp"
            android:textStyle="bold"
            app:drawableEndCompat="@android:drawable/arrow_down_float" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvActivityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBodyConditionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="center"
            android:padding="15dp"
            android:text="體態類型"
            android:textColor="#666666"
            android:textSize="18sp"
            android:textStyle="bold"
            app:drawableEndCompat="@android:drawable/arrow_down_float" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBodyConditionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etPetWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="center"
            android:hint="請輸入寵物體重 (kg)"
            android:inputType="numberDecimal"
            android:padding="15dp"
            android:textColor="#666666"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNextStep"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_rounded_button"
        android:text="下一步"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>