    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:tools="http://schemas.android.com/tools"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="寵物進食飲水資訊"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp"/>

        <FrameLayout
            android:id="@+id/btn_notification"
            android:layout_width="60dp"
            android:layout_height="35dp"
            android:background="@drawable/bg_notification_pill"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔔" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/pet_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_rounded_capsule"
            android:elevation="4dp"
            android:padding="8dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_pet_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/cat_flower"
                app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

            <TextView
                android:id="@+id/tv_pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_rounded_capsule"
            android:elevation="4dp"
            android:padding="4dp"
            app:layout_constraintTop_toTopOf="@id/pet_selector"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/iv_food_tab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/ic_food_bowl_orange"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/iv_water_tab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/ic_water_drop_blue"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/data_container"
            android:layout_width="0dp"
            android:layout_height="300dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_white_rounded_card"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/pet_selector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_login_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tv_login_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="請先登入以查看寵物健康數據"
                    android:textColor="#999999"
                    android:textSize="14sp" />
            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_todo_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 今日代辦事項"
            android:textColor="#8B4513"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/data_container"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/card_today_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_todo_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_todo_day_number"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="18"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:gravity="center" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="#EEEEEE"
                    android:layout_marginHorizontal="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_todo_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今日無代辦事項"
                        android:textSize="18sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_todo_time_pet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="點擊查看更多行程"
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>